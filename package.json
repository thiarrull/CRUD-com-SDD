{
  "name": "crud-com-sdd",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de agendamentos do Cenário B com OpenSpec e Clean Architecture",
  "main": "src/main/server.js",
  "type": "commonjs",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node src/main/server.js",
    "dev": "nodemon src/main/server.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "dotenv": "18.0.9",
    "ejs": "7.0.2",
    "express": "5.3.0",
    "helmet": "8.3.0"
  },
  "devDependencies": {
    "eslint": "10.13.0",
    "nodemon": "3.1.14",
    "prettier": "3.9.10",
    "supertest": "7.3.1"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
